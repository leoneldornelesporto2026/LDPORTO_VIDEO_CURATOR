{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldporto.local/contracts/curator_ready_v1.schema.json",
  "title": "LDPORTO_CURATOR_READY_V1 manifest",
  "type": "object",
  "required": ["contract", "version", "source_sha256", "files", "reels", "stories"],
  "properties": {
    "contract": {"const": "LDPORTO_CURATOR_READY_V1"},
    "version": {"type": "integer", "const": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "title": {"type": ["string", "null"]},
    "files": {
      "type": "array", "maxItems": 5000,
      "items": {
        "type": "object", "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 268435456},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "reels": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/folder"}},
    "stories": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/folder"}},
    "publication_ready": {"const": false},
    "approved": {"const": false}
  },
  "$defs": {
    "folder": {
      "type": "object", "required": ["path"],
      "properties": {"path": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
