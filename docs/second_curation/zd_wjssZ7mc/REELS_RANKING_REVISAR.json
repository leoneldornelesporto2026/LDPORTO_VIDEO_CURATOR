      "title_main": "POR QUE O RÁDIO NÃO ALCANÇAVA?",
      "title_alternatives": [
        "As antenas e a distância",
        "O desafio de falar com Belém"
      ],
      "topic_from_analyzer": "Problemas com o alcance das antenas na Amazônia e a antena de Tucuruí",
      "original_rank": 3,
      "source_segment_ids": [
        "SEG_00137",
        "SEG_00138",
