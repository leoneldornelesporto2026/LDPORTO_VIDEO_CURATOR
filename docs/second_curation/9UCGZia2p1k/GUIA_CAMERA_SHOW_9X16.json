  },
  "policies": [
    {
      "scene": "face_verified_one_person",
      "action": "dynamic_vertical_crop",
      "preconditions": [
        "observable face in source frames",
        "stable ROI over consecutive frames",
        "safe head/shoulders framing",
        "human confirmation if identity matters"
      ],
      "motion": "soft, smooth, no jump cuts; protect head and gestures"
    },
    {
      "scene": "vocal_with_microphone",
      "action": "follow_visible_vocalist",
      "preconditions": [
        "visible performing person in video",
        "not ASR-based identity inference"
      ],
      "motion": "medium to portrait when safe; never cut microphone/face"
    },
    {
      "scene": "guitar_close_up",
      "action": "instrument_roi_crop",
      "preconditions": [
        "guitar/instrument ROI visually recognized and confirmed"
      ],
      "motion": "micro-pan along fretboard only if tracked; keep fretting/strumming hands"
    },
    {
      "scene": "drums",
      "action": "drummer_wide_or_medium",
      "preconditions": [
        "instrument and visible drummer verified"
      ],
      "motion": "preserve drum kit and motion; avoid facial-only crop"
    },
    {
      "scene": "whole_band_wide",
      "action": "source_preserve",
      "preconditions": [
        "wide shot, multiple band members, stage lights"
      ],
      "motion": "preserve group and stage, optionally blur outside 16:9"
    },
    {
      "scene": "crowd_or_phone_lights",
      "action": "source_preserve_or_crowd_crop",
      "preconditions": [
        "crowd visible, verified faces not required"
      ],
      "motion": "preserve the event scale"
    },
    {
      "scene": "graphics_screens_maps",
      "action": "source_preserve",
      "preconditions": [
        "text, band graphics, screen, lyric or signage may be important"
      ],
      "motion": "no crop hiding words or marks"
    },
    {
      "scene": "ambiguous_identity_low_quality",
      "action": "source_preserve",
      "preconditions": [
        "unknown mapping, face absent, bad tracking"
      ],
      "motion": "no invented target; no forced zoom"
    }
  ],
  "presentation": {
    "recommended_mode": "AUTO_CONSERVADOR",
    "subtitle_preset": "LDP_REELS_KARAOKE",
    "subtitle_style": "yellow phrase -> cumulative white at measured onset",
    "max_lines": 2,
    "title_part_format": "TITULO ESPECIFICO — PARTE X/Y",
    "safe_area_check": true,
    "music_policy": "original concert audio preserved; no music replacement on performances"
