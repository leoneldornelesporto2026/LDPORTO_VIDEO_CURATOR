    "transcript/full_segments.jsonl": [
      {
        "segment_id": "S1",
        "start": 0.0,
        "end": 13.886621315192743,
        "speaker": "SYNTHETIC_NARRATOR",
        "text": "Esta é uma demonstração sintética local do Curator. O primeiro quadro mostra um painel azul com três caixas numeradas, que representam a ordem dos episódios.",
        "timestamp_method": "separate_sapi_wave_boundaries",
        "synthetic": true,
        "sentence_complete": true
      },
      {
        "segment_id": "S2",
        "start": 13.886621315192743,
        "end": 27.32235827664399,
        "speaker": "SYNTHETIC_NARRATOR",
        "text": "No segundo quadro, as caixas estão conectadas por uma linha. A sequência mantém os tempos da fonte, e as lacunas ficam registradas para a revisão humana.",
        "timestamp_method": "separate_sapi_wave_boundaries",
        "synthetic": true,
        "sentence_complete": true
      },
      {
        "segment_id": "S3",
        "start": 27.32235827664399,
        "end": 43.61741496598639,
        "speaker": "SYNTHETIC_NARRATOR",
        "text": "O último quadro mostra a palavra revisão. Os vídeos continuam sendo propostas: a pessoa precisa assistir à prévia, conferir as legendas e aprovar cada episódio antes do render final.",
        "timestamp_method": "separate_sapi_wave_boundaries",
        "synthetic": true,
        "sentence_complete": true
      }
    ],
