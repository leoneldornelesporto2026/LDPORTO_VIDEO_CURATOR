+def _load_bindings(args, parent):
+    """Verify every source and the saved parent before a camera-only fork writes anything."""
+    from ldporto_curator.approval import file_hash
+    from ldporto_curator.camera_metadata import load_existing_camera_metadata
+
+    expected_source = parent.evidence['source']['sha256']
+    if args.episode:
+        parent.episode(args.episode)
+        return {args.episode: load_existing_camera_metadata(args.micro, expected_source,
+            source_plan=args.metadata_project)}
+    manifest_path = args.bindings.resolve(strict=True)
+    document = json.loads(manifest_path.read_text(encoding='utf-8-sig'))
+    if document.get('schema') != 'LDP_STORIES_CAMERA_BINDINGS_V1':
+        raise ValueError('Unknown camera binding schema')
+    if document.get('source_sha256') != expected_source:
+        raise ValueError('Source SHA256 differs from manifest')
+    if document.get('project_index_sha256') != file_hash(parent.directory / 'series_index.json'):
+        raise ValueError('Parent plan changed after preparing bindings; review the manifest')
+    rows = document.get('episodes')
+    if not isinstance(rows, list) or not rows or not all(isinstance(row, dict) for row in rows):
+        raise ValueError('Missing or invalid episode bindings')
+    ids = [row.get('episode_id') for row in rows]
+    if any(not isinstance(identifier, str) for identifier in ids) or len(set(ids)) != len(ids):
+        raise ValueError('Invalid or duplicate episode IDs')
+    def referenced(value):
+        if not isinstance(value, str) or not value:
+            raise ValueError('Evidence path is required')
+        path = Path(value)
+        return path if path.is_absolute() else manifest_path.parent / path
+    micros = {}
+    for row in rows:
+        identifier = row['episode_id']
+        parent.episode(identifier)
+        if row.get('preserve_without_visual_evidence') is True:
+            if any(row.get(key) is not None for key in
+                    ('micro', 'metadata_project', 'micro_sha256', 'source_plan_sha256')):
+                raise ValueError('Preservation without evidence cannot also bind microperception')
+            micros[identifier] = {}
+            continue
+        path, source_plan = referenced(row.get('micro')), referenced(row.get('metadata_project'))
+        if file_hash(path) != row.get('micro_sha256') or file_hash(source_plan) != row.get('source_plan_sha256'):
+            raise ValueError('Visual evidence or ancestor plan SHA256 differs: ' + identifier)
+        micros[identifier] = load_existing_camera_metadata(path, expected_source, source_plan=source_plan)
+    return micros
+
+
